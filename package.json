{
  "name": "low-front",
  "private": true,
  "version": "1.0.0",
  "description": "Tactical low-poly FPS: Conquest against 31 bots.",
  "author": "Low Front",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:match": "BOT_MATCH=1 vitest run tests/BotMatch.test.ts --silent=false",
    "pc": "npm run build && electron .",
    "build:pc": "node scripts/icon.mjs && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
